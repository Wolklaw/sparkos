#!/bin/sh
# Spark Secrets: the saved-passwords service (org.freedesktop.secrets) of the Spark session.
# The user unit spark-secrets.service runs it. Also:
#   spark-secrets --import-gnome-keyring [FILE]   copy a GNOME Keyring file in (daemon stopped)
#   spark-secrets --self-test | --version
export PYTHONPATH=/usr/lib/spark-session${PYTHONPATH:+:$PYTHONPATH}
exec /usr/bin/python3 -s -m sparksession.secrets_service "$@"
