#!/bin/bash
# What greetd runs as its greeter (see /usr/share/spark-session/greetd-config.toml):
# spark-compositor with spark-greeter as its only window. When the greeter exits it stops the
# compositor, and greetd then starts the session that was chosen (or the greeter again).
#
# Everything here is for the sign-in screen only. It runs as the `greetd` user, never as you.
set -u

# greetd's PAM stack (pam_systemd) normally gives the greeter a runtime directory. If it did
# not, make a private one so the compositor can still make its socket.
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -w "${XDG_RUNTIME_DIR:-/nonexistent}" ]; then
  XDG_RUNTIME_DIR=$(mktemp -d /tmp/spark-greeter.XXXXXX) || exit 1
  chmod 700 "$XDG_RUNTIME_DIR"
  export XDG_RUNTIME_DIR
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=SparkGreeter
export GTK_A11Y=none            # no accessibility bus on the sign-in screen
export SPARK_GREETER_CACHE=${SPARK_GREETER_CACHE:-/var/cache/spark-greeter}
# The compositor's own settings (outputs, keyboard) for the sign-in screen: none from a home
# folder, so it never reads the greetd user's files.
export SPARK_COMPOSITOR_CONFIG_DIR=${SPARK_COMPOSITOR_CONFIG_DIR:-/usr/share/spark-session/greeter-compositor}

# greetd gives us the VT as stdout. Text written there shows through for a moment when the
# sign-in screen closes, so the log goes to the journal (journalctl -t spark-greeter) instead.
if [ -t 1 ]; then
  if command -v systemd-cat >/dev/null 2>&1; then
    exec > >(exec systemd-cat -t spark-greeter) 2>&1 </dev/null
  else
    exec >/dev/null 2>&1 </dev/null
  fi
fi

greeter=${SPARK_GREETER_BIN:-/usr/bin/spark-greeter}
compositor=${SPARK_GREETER_COMPOSITOR:-/usr/bin/spark-compositor}

run() {
  # The subshell's PID becomes the compositor's (exec keeps it), so the startup command knows
  # which process to stop when the greeter is done.
  ( exec "$compositor" -s "$greeter; kill -TERM $BASHPID" )
}

if command -v dbus-run-session >/dev/null 2>&1; then
  export -f run
  export greeter compositor
  exec dbus-run-session -- bash -c run
fi
run
