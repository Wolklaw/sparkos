#!/bin/bash
# Chooses SparkOS's sign-in screen. greetd always signs you in; this picks what greetd shows.
# `spark greeter` calls this as root; spark-greeter-fallback.service calls `auto-rollback` when
# the Spark greeter keeps failing.
#
#   spark-greeter-ctl status         what signs you in, and whether everything it needs is there
#   spark-greeter-ctl enable         the Spark sign-in screen (the default)
#   spark-greeter-ctl disable        greetd's text sign-in (agreety), which starts the Spark session
#   spark-greeter-ctl auto-rollback  disable, and start greetd again now (fallback unit)
#
# enable and disable start or stop nothing: the change takes effect at the next restart.
#
# For tests: SPARK_GREETER_ROOT=DIR works on a copy of the tree, SPARK_GREETER_SYSTEMCTL=CMD
# replaces systemctl.
set -euo pipefail

ROOT=${SPARK_GREETER_ROOT:-}
SYSTEMCTL=${SPARK_GREETER_SYSTEMCTL:-systemctl}
CONFIG=$ROOT/etc/greetd/config.toml
OURS=$ROOT/usr/share/spark-session/greetd-config.toml
TEXT=$ROOT/usr/share/spark-session/greetd-text.toml
DM_LINK=$ROOT/etc/systemd/system/display-manager.service

say() { printf '%s\n' "$*"; }
die() { printf 'spark-greeter-ctl: %s\n' "$*" >&2; exit 1; }

need_root() {
  [ -n "$ROOT" ] || [ "$(id -u)" = 0 ] || die "needs admin rights"
}

current_dm() {
  if [ -L "$DM_LINK" ]; then basename "$(readlink "$DM_LINK")"; fi
}

same() { [ -f "$1" ] && [ -f "$2" ] && [ "$(< "$1")" = "$(< "$2")" ]; }

mode() {
  if same "$CONFIG" "$OURS"; then echo spark
  elif same "$CONFIG" "$TEXT"; then echo text
  else echo other; fi
}

cmd_status() {
  local dm
  dm=$(current_dm)
  say "Display manager: ${dm:-nothing found}"
  case "$(mode)" in
    spark) say "Sign-in screen: Spark. Switch to the text sign-in with: spark greeter disable" ;;
    text)  say "Sign-in screen: text (the Spark one failed or was turned off). Back to Spark: spark greeter enable" ;;
    *)     say "Sign-in screen: /etc/greetd/config.toml was changed by hand. Spark's: spark greeter enable" ;;
  esac
  local ok=1 f
  for f in /usr/bin/greetd /usr/bin/spark-greeter /usr/libexec/spark-greeter-session; do
    [ -x "$ROOT$f" ] || { say "missing: $f"; ok=0; }
  done
  ls "$ROOT"/usr/share/wayland-sessions/*.desktop >/dev/null 2>&1 \
    && say "Sessions it will offer: $(grep -h '^Name=' "$ROOT"/usr/share/wayland-sessions/*.desktop | cut -d= -f2 | paste -sd, | sed 's/,/, /g')" \
    || { say "no sessions in /usr/share/wayland-sessions"; ok=0; }
  [ "$ok" = 1 ] && say "Everything the Spark sign-in screen needs is installed." \
    || say "Something is missing: keep the text sign-in."
}

use() {   # use FILE: make FILE greetd's config and greetd the display manager
  mkdir -p "$(dirname "$CONFIG")"
  install -m 0644 "$1" "$CONFIG"
  [ "$(current_dm)" = greetd.service ] || $SYSTEMCTL enable --force greetd.service
}

cmd_enable() {
  need_root
  local f
  for f in /usr/bin/greetd /usr/bin/spark-greeter /usr/libexec/spark-greeter-session; do
    [ -x "$ROOT$f" ] || die "$f is missing, so the Spark sign-in screen cannot start. Nothing was changed."
  done
  [ -f "$OURS" ] || die "$OURS is missing. Nothing was changed."
  ls "$ROOT"/usr/share/wayland-sessions/*.desktop >/dev/null 2>&1 \
    || die "there are no sessions in /usr/share/wayland-sessions to sign in to. Nothing was changed."
  use "$OURS"
  say "The Spark sign-in screen is on from the next restart. Nothing was stopped."
  say "If it does not come up, it switches to the text sign-in by itself after a few failures."
}

cmd_disable() {
  need_root
  [ -f "$TEXT" ] || die "$TEXT is missing. Nothing was changed."
  use "$TEXT"
  say "The text sign-in is on from the next restart. Nothing was stopped."
}

cmd_auto_rollback() {
  need_root
  [ "$(mode)" = spark ] || { say "The Spark sign-in screen is not the one in use; nothing to do."; return 0; }
  say "The Spark sign-in screen failed repeatedly; switching to the text sign-in."
  cmd_disable
  $SYSTEMCTL reset-failed greetd.service || true
  $SYSTEMCTL start --no-block greetd.service || true
}

case "${1:-status}" in
  status) cmd_status ;;
  enable) cmd_enable ;;
  disable) cmd_disable ;;
  auto-rollback) cmd_auto_rollback ;;
  *) die "unknown command: $1 (status, enable, disable)" ;;
esac
