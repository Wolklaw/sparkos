#!/usr/bin/python3 -s
# Run by pam_exec.so from greetd's PAM file at sign-in (as root, password on stdin). Leaves the key
# that unlocks the user's saved passwords in /run/spark-secrets/UID, owned by that user, 0400.
# It never fails the sign-in: whatever goes wrong, it exits 0 and Spark Secrets asks later.
import os
import pwd
import sys

sys.path.insert(0, '/usr/lib/spark-session')

try:
    from sparksession import secrets_store as store

    user = os.environ.get('PAM_USER', '')
    if os.environ.get('PAM_TYPE') == 'auth' and user:
        raw = sys.stdin.buffer.read(4096)
        password = store.password_from_stdin(raw)
        if password:
            entry = pwd.getpwnam(user)
            key = store.wrapping_key(password, user)
            # the override is for tests only: as root (real sign-ins) the path is fixed
            base = '/run/spark-secrets' if os.geteuid() == 0 else os.environ.get('SPARK_SECRETS_RUN', '/run/spark-secrets')
            os.makedirs(base, mode=0o711, exist_ok=True)
            path = os.path.join(base, str(entry.pw_uid))
            tmp = path + '.tmp'
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400)
            with os.fdopen(fd, 'wb') as handle:
                handle.write(key.hex().encode() + b'\n')
            os.chown(tmp, entry.pw_uid, entry.pw_gid)
            os.replace(tmp, path)
except Exception as exc:       # noqa: BLE001
    print(f'spark-secrets-pam: {type(exc).__name__}', file=sys.stderr)
sys.exit(0)
