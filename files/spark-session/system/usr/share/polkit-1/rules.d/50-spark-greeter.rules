// The Spark sign-in screen has sleep, restart and shut down buttons. They run as the greetd
// account, which has no session of its own, so polkit would ask for a password nobody can
// type. Allow exactly those three actions for that account and nothing else.
polkit.addRule(function(action, subject) {
    if (subject.user !== "greetd") {
        return polkit.Result.NOT_HANDLED;
    }
    var allowed = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.freedesktop.login1.suspend-multiple-sessions"
    ];
    if (allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
