{
  "id": "dev.wolklaw.SparkGames",
  "slug": "spark-games",
  "name": "Spark Games",
  "summary": "One library for every installed game: Steam, Heroic (Epic, GOG, Amazon), Lutris and your own.",
  "summary_fr": "Une seule bibliothèque pour tous les jeux installés : Steam, Heroic (Epic, GOG, Amazon), Lutris et les vôtres.",
  "version": "0.1.0",
  "size_kb": 260,
  "optional": true,
  "icon": "icons/spark-games-256.png",
  "desktop": "dev.wolklaw.SparkGames.desktop",
  "command": "spark-games",
  "install": {
    "user": "install.sh --user",
    "uninstall": "install.sh --user --uninstall",
    "system": "install.sh --deps"
  },
  "needs": {
    "root": false,
    "python": ">=3.9",
    "python_modules": ["tkinter", "PIL", "PIL.ImageTk", "sqlite3"],
    "commands": ["xdg-open"],
    "optional_commands": ["flatpak", "steam", "lutris", "gamemoderun", "mangohud", "umu-run", "kdialog"]
  },
  "reads": [
    "~/.var/app/com.valvesoftware.Steam/.local/share/Steam",
    "~/.local/share/Steam",
    "~/.var/app/com.heroicgameslauncher.hgl/config/heroic",
    "~/.config/heroic",
    "~/.var/app/net.lutris.Lutris/data/lutris",
    "~/.local/share/lutris"
  ],
  "writes": [
    "~/.config/spark-games",
    "~/.local/share/spark-games",
    "~/.cache/spark-games",
    "~/.local/state/spark-games"
  ],
  "network": "Optional: downloads the public AreWeAntiCheatYet game list at most once a week (can be turned off in Settings)."
}
