#include <winver.h>

1 ICON "hello.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Wolklaw (Spark Run test)"
      VALUE "FileDescription", "Spark Hello"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "hello.exe"
      VALUE "ProductName", "Spark Hello"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
