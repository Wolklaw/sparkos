[Desktop Entry]
Type=Application
Name=Spark Monitor
Name[fr]=Spark Monitor
GenericName=Task manager
GenericName[fr]=Gestionnaire des tâches
Comment=See what your PC is doing and end apps that stopped responding
Comment[fr]=Voir ce que fait votre PC et fermer les applications qui ne répondent plus
Exec=spark-monitor
Icon=dev.wolklaw.SparkMonitor
Terminal=false
Categories=System;Monitor;
Keywords=task manager;task;manager;process;processes;end task;kill;cpu;memory;ram;gpu;disk;network;performance;startup;monitor;ctrl+shift+esc;gestionnaire;tâches;processus;mémoire;démarrage;
Keywords[fr]=gestionnaire des tâches;tâche;processus;fin de tâche;processeur;mémoire;carte graphique;disque;réseau;performances;démarrage;
StartupWMClass=SparkMonitor
SingleMainWindow=true
Actions=Performance;Startup;

[Desktop Action Performance]
Name=Performance
Name[fr]=Performances
Exec=spark-monitor --tab performance

[Desktop Action Startup]
Name=Startup apps
Name[fr]=Applications au démarrage
Exec=spark-monitor --tab startup
