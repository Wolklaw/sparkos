{
  "id": "dev.wolklaw.SparkWelcome",
  "slug": "spark-welcome",
  "name": "Spark Welcome",
  "description": "First-login setup: game launchers and apps from Flathub, your files from Windows, and a check of this PC.",
  "version": "1.0.1",
  "size_kb": 200,
  "needs": {
    "python": ">=3.9",
    "python_modules": ["tkinter"],
    "programs": ["flatpak", "udisksctl", "lsblk"],
    "optional_programs": ["xdg-user-dir", "xdg-open", "vulkaninfo", "wpctl", "pw-play", "lpstat", "scanimage", "nmcli", "bluetoothctl", "rpm-ostree", "systemsettings"],
    "network": "only to install apps the user picks, from Flathub",
    "root": false
  },
  "install": "install.sh --user",
  "uninstall": "install.sh --user --uninstall",
  "command": "spark-welcome",
  "autostart": true,
  "license": "Apache-2.0",
  "source": "https://github.com/Wolklaw/sparkos/tree/main/files/spark-welcome"
}
