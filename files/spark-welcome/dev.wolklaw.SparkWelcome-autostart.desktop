[Desktop Entry]
Type=Application
Name=Spark Welcome
Name[fr]=Spark Welcome
Comment=Opens once at the first login; does nothing after that
Comment[fr]=S'ouvre une fois à la première connexion, puis ne fait plus rien
Exec=spark-welcome --first-login
Icon=dev.wolklaw.SparkWelcome
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
