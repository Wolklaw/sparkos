# SparkOS (Fedora base): Homebrew's automatic update. Off until `sparkos-dev-setup --brew` (00-sparkos-homebrew.preset).
[Unit]
Description=Homebrew: brew update
After=local-fs.target network-online.target
Wants=network-online.target
ConditionPathIsSymbolicLink=/home/linuxbrew/.linuxbrew/bin/brew

[Service]
Type=oneshot
ExecStart=/usr/libexec/sparkos-brew-run update
