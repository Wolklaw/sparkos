[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-zip-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-lz4-compressed-tar;application/x-lzip-compressed-tar;application/x-tarz;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-cd-image;application/x-iso9660-image;application/gzip;application/x-bzip;application/x-bzip2;application/x-xz;application/zstd;application/x-spark-rar-part;application/x-spark-zip-part;application/x-spark-split-part;
Actions=extractHere;extractFolder;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Extract
X-KDE-Submenu[fr]=Extraire

[Desktop Action extractHere]
Name=Extract here
Name[fr]=Extraire ici
Icon=dev.wolklaw.SparkArchive
Exec=spark-archive --extract-here %F

[Desktop Action extractFolder]
Name=Extract to folder
Name[fr]=Extraire dans un dossier
Icon=dev.wolklaw.SparkArchive
Exec=spark-archive --extract-folder %F
