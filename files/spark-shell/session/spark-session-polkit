#!/bin/sh
# The polkit agent of the Spark session. Placeholder: runs Spark's own agent when the image has
# one (/usr/bin/spark-polkit-agent), otherwise the KDE agent Plasma uses, so password prompts
# work either way. The lock screen / polkit work replaces the KDE fallback.
for agent in /usr/bin/spark-polkit-agent /usr/libexec/kf6/polkit-kde-authentication-agent-1; do
    [ -x "$agent" ] && exec "$agent"
done
echo "spark-session-polkit: no polkit agent installed" >&2
exit 1
