#!/bin/sh
# Runs inside the Spark compositor (spark-wl-startup starts it; the session ends when it exits).
# Brings up the environment for D-Bus activation and systemd, the helper services
# (spark-wl-workspace.target: portal, polkit agent, xembed tray proxy, autostart) and then the
# Spark shell.
# The shell is restarted if it crashes; leaving it on purpose (Quit) ends the session.

VARS="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
KDE_FULL_SESSION KDE_SESSION_VERSION XDG_MENU_PREFIX QT_WAYLAND_RECONNECT \
KDE_APPLICATIONS_AS_SCOPE XCURSOR_THEME XCURSOR_SIZE"

dbus-update-activation-environment --systemd $VARS 2>/dev/null \
    || dbus-update-activation-environment $VARS 2>/dev/null

use_systemd=0
if [ -z "$SPARK_SESSION_NO_SYSTEMD" ] && systemctl --user --no-pager is-system-running >/dev/null 2>&1; then
    use_systemd=1
elif [ -z "$SPARK_SESSION_NO_SYSTEMD" ] && [ "$(systemctl --user is-system-running 2>/dev/null)" = degraded ]; then
    use_systemd=1
fi

target=${SPARK_SESSION_TARGET:-spark-wl-workspace.target}

pids=""
if [ "$use_systemd" = 1 ]; then
    systemctl --user import-environment $VARS 2>/dev/null
    systemctl --user start "$target"
else
    # no user systemd (a test container): start the helpers ourselves
    for helper in /usr/libexec/spark-session-polkit; do
        if [ -x "$helper" ]; then
            "$helper" >/dev/null 2>&1 &
            pids="$pids $!"
        fi
    done
fi

here=$(dirname "$0")
# tests/headless.sh sets SPARK_SHELL_FROM_SOURCE: in the SparkOS image the installed shell would
# otherwise be tested instead of the checkout's
# a developer build in ~/.local/share/spark-dev/bin wins over the image's (see spark-wl-session)
dev_shell="$HOME/.local/share/spark-dev/bin/spark-shell"
if [ -x "$dev_shell" ] && [ -z "$SPARK_SHELL_FROM_SOURCE" ]; then
    run_shell() { "$dev_shell"; }
elif [ -x /usr/bin/spark-shell ] && [ -z "$SPARK_SHELL_FROM_SOURCE" ]; then
    run_shell() { /usr/bin/spark-shell; }
else
    run_shell() { python3 "$here/../spark_shell.py"; }      # a source checkout (tests)
fi

started=0
tries=0
status=0
while :; do
    began=$(date +%s)
    run_shell
    status=$?
    [ "$status" = 0 ] && break
    now=$(date +%s)
    if [ $((now - began)) -gt 60 ]; then tries=0; fi
    tries=$((tries + 1))
    started=$((started + 1))
    echo "spark-session: the shell stopped ($status), restart $tries of 5" >&2
    [ "$tries" -ge 5 ] && break
    sleep 1
done

if [ "$use_systemd" = 1 ]; then
    systemctl --user stop "$target"
else
    for p in $pids; do kill "$p" 2>/dev/null; done
fi
exit "$status"
