#!/bin/sh
# Runs inside the Spark compositor (spark-wl-startup starts it; the session ends when it exits).
# Brings up the environment for D-Bus activation and systemd, the helper services
# (spark-wl-workspace.target: portal, polkit agent, xembed tray proxy, autostart) and then the
# Spark shell.
# The shell is restarted if it crashes; leaving it on purpose (Quit) ends the session.

VARS="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
KDE_FULL_SESSION KDE_SESSION_VERSION XDG_MENU_PREFIX QT_WAYLAND_RECONNECT \
KDE_APPLICATIONS_AS_SCOPE XCURSOR_THEME XCURSOR_SIZE SSH_AUTH_SOCK GNOME_DESKTOP_SESSION_ID"

dbus-update-activation-environment --systemd $VARS 2>/dev/null \
    || dbus-update-activation-environment $VARS 2>/dev/null

use_systemd=0
if [ -z "$SPARK_SESSION_NO_SYSTEMD" ] && systemctl --user --no-pager is-system-running >/dev/null 2>&1; then
    use_systemd=1
elif [ -z "$SPARK_SESSION_NO_SYSTEMD" ] && [ "$(systemctl --user is-system-running 2>/dev/null)" = degraded ]; then
    use_systemd=1
fi

target=${SPARK_SESSION_TARGET:-spark-wl-workspace.target}

pids=""
if [ "$use_systemd" = 1 ]; then
    systemctl --user import-environment $VARS 2>/dev/null
    systemctl --user start "$target"
else
    # no user systemd (a test container): start the helpers ourselves
    for helper in /usr/libexec/spark-session-polkit; do
        if [ -x "$helper" ]; then
            "$helper" >/dev/null 2>&1 &
            pids="$pids $!"
        fi
    done
fi

here=$(dirname "$0")
# tests/headless.sh sets SPARK_SHELL_FROM_SOURCE: in the SparkOS image the installed shell would
# otherwise be tested instead of the checkout's
# a developer build in ~/.local/share/spark-dev/bin wins over the image's (see spark-wl-session)
# Checked at every start, not once: a dev build removed mid-session falls back to the image's
# shell at the next restart instead of failing five times and ending the shell.
dev_shell="$HOME/.local/share/spark-dev/bin/spark-shell"
run_shell() {
    if [ -x "$dev_shell" ] && [ -z "$SPARK_SHELL_FROM_SOURCE" ]; then
        "$dev_shell"
    elif [ -x /usr/bin/spark-shell ] && [ -z "$SPARK_SHELL_FROM_SOURCE" ]; then
        /usr/bin/spark-shell
    else
        python3 "$here/../spark_shell.py"      # a source checkout (tests)
    fi
}

# The compositor of this session: a process of our session scope running spark-compositor.
# This script is not its child (its parent is PID 1), so it is found by its binary.
compositor=""
if [ -r /proc/self/cgroup ]; then
    cg=$(sed -n 's/^0:://p' /proc/self/cgroup)
    for p in $(cat "/sys/fs/cgroup$cg/cgroup.procs" 2>/dev/null); do
        case $(readlink "/proc/$p/exe" 2>/dev/null) in
            */spark-compositor*) compositor=$p; break ;;
        esac
    done
fi

# Whether this session is still running: its compositor is alive (not a zombie) and logind
# has not started closing it. After a sign-out this script can outlive its compositor; a shell
# restarted then would land on the next session's compositor (same wayland-0), and stopping
# the target would take the next session's services down with it (a black screen).
session_alive() {
    if [ -n "$compositor" ]; then
        state=$(sed -n 's/^State:[[:space:]]*//p' "/proc/$compositor/status" 2>/dev/null)
        case $state in ''|Z*|X*) return 1 ;; esac
    fi
    if [ -n "$XDG_SESSION_ID" ]; then
        [ "$(loginctl show-session "$XDG_SESSION_ID" -p State --value 2>/dev/null)" = closing ] && return 1
    fi
    return 0
}

# Whether the session target is ours: spark-wl-startup puts this session's id in the user
# manager's environment. A newer session replaces it, and then the target is that session's.
owns_target() {
    [ -z "$XDG_SESSION_ID" ] && return 0
    current=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_SESSION_ID=//p')
    [ -z "$current" ] || [ "$current" = "$XDG_SESSION_ID" ]
}

started=0
tries=0
status=0
while :; do
    began=$(date +%s)
    run_shell
    status=$?
    [ "$status" = 0 ] && break
    now=$(date +%s)
    if [ $((now - began)) -gt 60 ]; then tries=0; fi
    tries=$((tries + 1))
    started=$((started + 1))
    sleep 1
    if ! session_alive; then
        echo "spark-session: the shell stopped ($status) and the session is over, not restarting" >&2
        break
    fi
    echo "spark-session: the shell stopped ($status), restart $tries of 5" >&2
    [ "$tries" -ge 5 ] && break
done

if [ "$use_systemd" = 1 ]; then
    if owns_target; then
        systemctl --user stop "$target"
    else
        echo "spark-session: a newer session runs $target, leaving it up" >&2
    fi
else
    for p in $pids; do kill "$p" 2>/dev/null; done
fi
exit "$status"
