<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SparkOS</vendor>
  <vendor_url>https://github.com/Wolklaw/sparkos</vendor_url>
  <icon_name>dev.wolklaw.SparkUpdate</icon_name>

  <!-- pkexec /usr/libexec/spark-update-helper: roll back, or change update settings -->
  <action id="dev.wolklaw.SparkUpdate.helper">
    <description>Roll back SparkOS or change its update settings</description>
    <description xml:lang="fr">Revenir à la version précédente de SparkOS ou changer ses réglages de mise à jour</description>
    <message>Spark Update needs an administrator password to roll back or change update settings.</message>
    <message xml:lang="fr">Spark Update a besoin d'un mot de passe d'administrateur pour revenir à la version précédente ou changer les réglages de mise à jour.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/spark-update-helper</annotate>
  </action>
</policyconfig>
