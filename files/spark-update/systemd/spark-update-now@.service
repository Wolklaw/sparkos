# Check now, from the Spark Update window: %i is "check" (only look) or "stage" (download
# and stage). Active local users may start it without a password
# (/usr/share/polkit-1/rules.d/50-spark-update.rules). It never restarts the PC.
[Unit]
Description=Spark Update: check now (%i)
Documentation=file:///usr/lib/spark-update/README.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot
ExecStart=/usr/bin/spark-update --system-run --now %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StateDirectory=spark-update
StateDirectoryMode=0755
LogsDirectory=spark-update
LogsDirectoryMode=0755
TimeoutStartSec=4h
SELinuxContext=system_u:unconfined_r:unconfined_t:s0
