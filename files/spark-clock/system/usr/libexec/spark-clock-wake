#!/usr/bin/python3 -I
"""spark-clock-wake: the one thing Spark Clock needs root for, run through pkexec.

  pkexec /usr/libexec/spark-clock-wake set <epoch>   wake the PC from sleep at that moment
  pkexec /usr/libexec/spark-clock-wake clear         drop this user's wake time
  /usr/libexec/spark-clock-wake check                needs no root: can this PC do it?

It does one thing: a systemd timer with WakeSystem=true whose only job is to run /usr/bin/true.
The timer is named after the caller's uid (from pkexec, never from the arguments), so one person
has at most one wake time and nobody can touch another person's. The time must be a plain
10 digit epoch, at least MIN_AHEAD seconds away and at most MAX_AHEAD (8 days) away. No shell,
fixed absolute programs, a fixed environment. Anything else is refused with exit 2.

This file ships in the image only (root code never comes from a live app bundle).
"""

import os
import re
import subprocess
import sys
import time

MIN_AHEAD = 10                      # seconds from now
MAX_AHEAD = 8 * 24 * 3600
PREFIX = "spark-clock-wake-"
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMD_RUN = "/usr/bin/systemd-run"
TRUE = "/usr/bin/true"
RTC = "/sys/class/rtc/rtc0/wakealarm"
ENV = {"PATH": "/usr/bin:/usr/sbin", "LANG": "C", "LC_ALL": "C"}
EPOCH = re.compile(r"[0-9]{10}")
UID = re.compile(r"[1-9][0-9]{0,9}")


class Refused(Exception):
    pass


def parse(argv, now):
    """argv after the program name -> ('set', epoch) | ('clear',) | ('check',)."""
    if len(argv) == 1 and argv[0] in ("clear", "check"):
        return (argv[0],)
    if len(argv) == 2 and argv[0] == "set":
        if not EPOCH.fullmatch(argv[1]):
            raise Refused("the time must be a 10 digit epoch")
        when = int(argv[1])
        if when < now + MIN_AHEAD:
            raise Refused("the time is not in the future")
        if when > now + MAX_AHEAD:
            raise Refused("the time is more than 8 days away")
        return ("set", when)
    raise Refused("usage: set <epoch> | clear | check")


def unit_name(environ):
    """The caller's uid comes from pkexec only. Root and anything odd is refused."""
    uid = environ.get("PKEXEC_UID", "")
    if not UID.fullmatch(uid):
        raise Refused("run it through pkexec as a normal user")
    return PREFIX + uid


def calendar(when):
    return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(when))


def stop_argv(unit):
    return [SYSTEMCTL, "stop", unit + ".timer", unit + ".service"]


def set_argv(unit, when):
    return [SYSTEMD_RUN, "--quiet", "--collect", "--unit=" + unit,
            "--description=Spark Clock wake alarm",
            "--timer-property=WakeSystem=true", "--timer-property=AccuracySec=1s",
            "--on-calendar=" + calendar(when), TRUE]


def default_run(argv):
    done = subprocess.run(argv, capture_output=True, text=True, timeout=20, env=ENV,
                          stdin=subprocess.DEVNULL, check=False)
    return done.returncode, (done.stderr or done.stdout)


def check(exists=os.path.exists):
    if not exists(RTC):
        return "this PC has no real-time clock wake alarm"
    if not exists(SYSTEMD_RUN):
        return "systemd-run is missing"
    return None


def main(argv=None, environ=None, run=default_run, clock=time.time, out=None, err=None,
         exists=os.path.exists):
    argv = list(sys.argv[1:] if argv is None else argv)
    environ = os.environ if environ is None else environ
    out, err = out or sys.stdout, err or sys.stderr
    try:
        command = parse(argv, clock())
        if command[0] == "check":
            why = check(exists)
            print("ok" if why is None else "no: " + why, file=out)
            return 0 if why is None else 1
        unit = unit_name(environ)
        run(stop_argv(unit))                      # fine if there was nothing to stop
        if command[0] == "clear":
            print("ok clear", file=out)
            return 0
        why = check(exists)
        if why is not None:
            print(f"spark-clock-wake: {why}", file=err)
            return 1
        code, message = run(set_argv(unit, command[1]))
        if code != 0:
            print(f"spark-clock-wake: failed: {message.strip() or 'exit ' + str(code)}",
                  file=err)
            return 1
        print(f"ok set {command[1]}", file=out)
        return 0
    except Refused as exc:
        print(f"spark-clock-wake: refused: {exc}", file=err)
        return 2
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"spark-clock-wake: failed: {exc}", file=err)
        return 1


if __name__ == "__main__":
    sys.exit(main())
