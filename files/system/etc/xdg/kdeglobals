# SparkOS system-wide KDE defaults.
# A user's own settings in ~/.config/kdeglobals still win.
[KDE]
LookAndFeelPackage=dev.wolklaw.sparkos.desktop
# The Dark Mode switch in the Brightness & Color popup (and automatic day/night switching)
# swaps between these two. SparkOS has one look, so both point at it; otherwise the switch
# jumps to Breeze Dark and replaces the SparkOS colours, icons and splash.
DefaultDarkLookAndFeel=dev.wolklaw.sparkos.desktop
DefaultLightLookAndFeel=dev.wolklaw.sparkos.desktop
SingleClick=false
widgetStyle=Breeze

[KDE Control Module Restrictions][$i]
kcm_updates=false

# Hide KDE's "Get New Stuff" (themes and add-ons downloaded from store.kde.org inside Settings
# and apps). A user can turn it back on with ghns=true in ~/.config/kdeglobals.
[KDE Action Restrictions]
ghns=false

[General]
ColorScheme=SparkOS
AccentColor=155,232,184
accentColorFromWallpaper=false
font=Inter,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
toolBarFont=Inter,9,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0
fixed=Cascadia Mono,10,-1,5,50,0,0,0,0,0
# Spark Terminal is the terminal (files/scripts/spark-terminal.sh): Dolphin's "Open Terminal
# Here" and apps with Terminal=true start it
TerminalApplication=spark-terminal
TerminalService=dev.wolklaw.SparkTerminal.desktop

