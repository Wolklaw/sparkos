#!/usr/bin/bash
# What happens when you double-click a downloaded installer or program on SparkOS.
#
#   .exe / .msi (Windows)   opens in Spark Run: run once, or install as an app (Wine on first use)
#   .AppImage               asks once: add it to the app menu (moves it to ~/Applications) or run it
#   .rpm (Fedora)           asks, installs it into the system, offers to restart
#   .deb (Ubuntu/Debian)    explains it can't install that kind, and offers the Store
#
# Spark Run downloads Wine for the current user the first time, without an admin password.
# AppImages need no helper app: SparkOS handles them.
# .flatpakref links open in the Store (Bazaar) directly.
#
# Without dialogs (for scripts and the boot test):
#   sparkos-open-package --add-appimage FILE               add an AppImage to the menu, print its entry
#   sparkos-open-package --remove-appimage ENTRY [--yes]   remove an added AppImage and its entry
set -uo pipefail

# ---------- AppImages, SparkOS's own way
# "Add" moves the file to ~/Applications, makes it executable, takes the name and icon from the
# .desktop file inside it, and writes a menu entry with a "Remove from this PC" action.
# AppImages run through FUSE (fuse, fuse-libs and fuse3 are in the image).
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
APPS_DIR="$HOME/Applications"
ENTRY_DIR="$DATA_HOME/applications"
ICON_DIR="$DATA_HOME/sparkos/appimage-icons"

run_detached() { setsid -f "$@" >/dev/null 2>&1 < /dev/null; }

refresh_menu() {
  update-desktop-database -q "$ENTRY_DIR" 2>/dev/null || true
  (kbuildsycoca6 >/dev/null 2>&1 &)
}

# One file from inside the AppImage, through its own runtime (no FUSE needed), into $work
extract_one() { (cd "$work" && timeout 60 "$dest" --appimage-extract "$1" >/dev/null 2>&1); }

# The value of a key in the [Desktop Entry] group of a .desktop file
entry_key() { sed -n "/^\[Desktop Entry\]/,/^\[/{s/^$2=//p}" "$1" 2>/dev/null | head -1; }

# Adds the AppImage to the menu and prints the path of the menu entry it wrote.
appimage_add() {
  local src=$1 base slug dest entry work inner name comment cats wmclass icon_name icon cand f ext
  case "$HOME$DATA_HOME" in *[\"\`\$\\%]*)
    echo "your home folder's path has a character a menu entry can't hold" >&2; return 1 ;;
  esac
  base=$(basename -- "$src")
  slug=$(printf '%s' "${base%.*}" | tr -c 'A-Za-z0-9._+-' '_')
  [ -n "$slug" ] || slug=app
  dest="$APPS_DIR/$slug.AppImage"
  entry="$ENTRY_DIR/sparkos-appimage-$slug.desktop"
  mkdir -p "$APPS_DIR" "$ENTRY_DIR" "$ICON_DIR" || return 1
  if [ "$(realpath -- "$src")" != "$(realpath -m -- "$dest")" ]; then
    # Replaces an older copy with the same name (an update). From a read-only drive, copy it.
    mv -f -- "$src" "$dest" 2>/dev/null || cp -f -- "$src" "$dest" || return 1
  fi
  chmod +x -- "$dest" || return 1

  # Name and icon from the .desktop file inside it
  work=$(mktemp -d)
  extract_one '*.desktop'
  inner=$(find "$work/squashfs-root" -maxdepth 1 -name '*.desktop' -print -quit 2>/dev/null)
  if [ -n "$inner" ]; then
    name=$(entry_key "$inner" Name); comment=$(entry_key "$inner" Comment)
    cats=$(entry_key "$inner" Categories); wmclass=$(entry_key "$inner" StartupWMClass)
    icon_name=$(entry_key "$inner" Icon); icon_name=${icon_name##*/}
  fi
  [ -n "${name:-}" ] || name=$(tr '_' ' ' <<<"${slug%%-[0-9]*}")
  icon=application-x-executable
  for cand in ${icon_name:+"$icon_name.png" "$icon_name.svg" "$icon_name.xpm"} .DirIcon; do
    extract_one "$cand"
    f="$work/squashfs-root/$cand"
    if [ -L "$f" ]; then # .DirIcon is often a link to the real icon
      extract_one "$(readlink "$f")"
      cand=$(readlink "$f")
    fi
    [ -s "$f" ] || continue
    case "$cand" in
      *.png|*.svg|*.xpm) ext=${cand##*.} ;;
      *) if [ "$(head -c 4 -- "$f" | tail -c 3)" = PNG ]; then ext=png
         elif head -c 1024 -- "$f" | grep -q '<svg'; then ext=svg
         else continue; fi ;;
    esac
    rm -f -- "$ICON_DIR/$slug".*
    cp -L -- "$f" "$ICON_DIR/$slug.$ext" && icon="$ICON_DIR/$slug.$ext"
    break
  done
  rm -rf -- "$work"

  {
    echo "[Desktop Entry]"
    echo "Type=Application"
    echo "Name=$name"
    [ -z "${comment:-}" ] || echo "Comment=$comment"
    echo "Exec=\"$dest\" %U"
    echo "TryExec=$dest"
    echo "Icon=$icon"
    echo "Terminal=false"
    echo "Categories=${cats:-Utility;}"
    [ -z "${wmclass:-}" ] || echo "StartupWMClass=$wmclass"
    echo "X-SparkOS-AppImage=$dest"
    echo "Actions=SparkOSRemove;"
    echo
    echo "[Desktop Action SparkOSRemove]"
    echo "Name=Remove from this PC"
    echo "Name[fr]=Supprimer de ce PC"
    echo "Icon=edit-delete"
    echo "Exec=sparkos-open-package --remove-appimage \"$entry\""
  } > "$entry.tmp" && mv -f -- "$entry.tmp" "$entry" || return 1
  refresh_menu
  echo "$entry"
}

# Deletes an AppImage added above, its icon and its menu entry (asks first unless --yes).
appimage_remove() {
  local entry=${1:-} yes=${2:-} app icon name
  case "$entry" in "$ENTRY_DIR"/sparkos-appimage-*.desktop) ;; *)
    echo "not an AppImage menu entry made by SparkOS: $entry" >&2; return 1 ;;
  esac
  [ -f "$entry" ] || { echo "not found: $entry" >&2; return 1; }
  app=$(entry_key "$entry" X-SparkOS-AppImage)
  icon=$(entry_key "$entry" Icon)
  name=$(entry_key "$entry" Name)
  case "$app" in "$APPS_DIR"/*.AppImage) ;; *) app="" ;; esac
  case "$icon" in "$ICON_DIR"/*) ;; *) icon="" ;; esac
  if [ "$yes" != --yes ]; then
    kdialog --title "Remove $name" --yes-label "Remove" --no-label "Cancel" --warningyesno \
"Remove <b>$name</b> from this PC?<br><br>This deletes ${app:-the app} and its menu entry.
Its settings in your home folder stay." || return 0
  fi
  rm -f -- "$entry" ${app:+"$app"} ${icon:+"$icon"}
  refresh_menu
  echo "Removed $name."
}

# Double-clicked: ask once, then add it to the menu or run it where it is.
open_appimage() {
  local real entry err added
  real=$(realpath -- "$file")
  # Already added (opened from ~/Applications): just run it. Paths are compared resolved,
  # since /home is a link to /var/home on SparkOS.
  for entry in "$ENTRY_DIR"/sparkos-appimage-*.desktop; do
    [ -f "$entry" ] || continue
    added=$(entry_key "$entry" X-SparkOS-AppImage)
    if [ -n "$added" ] && [ "$(realpath -m -- "$added")" = "$real" ]; then
      run_detached "$added"; return
    fi
  done
  kdialog --title "Open $name" --yes-label "Add to the app menu" --no-label "Run once" --cancel-label "Cancel" --yesnocancel \
"<b>$name</b> is an AppImage: a whole app in one file, from whoever made it. SparkOS can't check
what it does, so open it only if you trust where it came from.<br><br>
<b>Add to the app menu</b> moves it to your Applications folder and adds it to the menu.
Right-click it there to remove it later. Updates come from the app itself, if it has them.<br>
<b>Run once</b> starts it from where it is."
  case $? in
    0)
      err=$(mktemp)
      if ! entry=$(appimage_add "$file" 2>"$err"); then
        kdialog --error "$name couldn't be added to the app menu. $(cat "$err")"; rm -f "$err"; return 1
      fi
      rm -f "$err"
      kdialog --title "Added" --yes-label "Open it now" --no-label "Later" --yesno \
        "<b>$(entry_key "$entry" Name)</b> is in your app menu." \
        && run_detached "$(entry_key "$entry" X-SparkOS-AppImage)"
      ;;
    1)
      if [ ! -x "$real" ] && ! chmod +x -- "$real" 2>/dev/null; then
        # A drive that won't take the executable bit: run a copy from a temporary folder
        real="$(mktemp -d)/$name" && cp -- "$file" "$real" && chmod +x -- "$real" \
          || { kdialog --error "$name couldn't be started."; return 1; }
      fi
      run_detached "$real"
      ;;
  esac
}

case "${1:-}" in
  --add-appimage)
    [ -f "${2:-}" ] || { echo "usage: sparkos-open-package --add-appimage FILE" >&2; exit 2; }
    appimage_add "$2"; exit ;;
  --remove-appimage)
    appimage_remove "${2:-}" "${3:-}"; exit ;;
esac

file="${1:-}"
[ -f "$file" ] || { kdialog --error "File not found: $file"; exit 1; }
name=$(basename "$file")

open_store() {
  for d in /usr/share/applications /var/lib/flatpak/exports/share/applications; do
    if [ -f "$d/io.github.kolunmi.Bazaar.desktop" ]; then
      gio launch "$d/io.github.kolunmi.Bazaar.desktop" >/dev/null 2>&1 &
      return
    fi
  done
  kdialog --sorry "The Store (Bazaar) isn't installed."
}

case "${name,,}" in
  *.exe|*.msi)
    exec spark-run "$file"
    ;;
  *.appimage)
    open_appimage
    ;;
  *.rpm)
    title=$(rpm -qp --qf '%{NAME} %{VERSION}' "$file" 2>/dev/null) || title=$name
    summary=$(rpm -qp --qf '%{SUMMARY}' "$file" 2>/dev/null) || summary=""
    kdialog --title "Install $title" --yes-label "Install" --no-label "Cancel" --yesno \
"<b>$title</b><br>$summary<br><br>SparkOS adds this program to the system. It's ready after you restart.<br><br>
It won't update by itself. If the program is also in the Store (Bazaar), install it from there
instead: Store apps install without a restart and update automatically." || exit 0

    status_file=$(mktemp)
    konsole --nofork -e bash -c '
      echo "Installing $1 (asks for your password)..."; echo
      pkexec rpm-ostree install --idempotent --allow-inactive "$1"; echo $? > "$2"
      echo; read -rp "Press Enter to close this window. " _' _ "$file" "$status_file"
    status=$(cat "$status_file" 2>/dev/null); rm -f "$status_file"

    if [ "$status" = 0 ]; then
      kdialog --title "Installed" --yes-label "Restart now" --no-label "Later" --yesno \
        "$title is installed. Restart to start using it." && systemctl reboot
    else
      kdialog --title "Not installed" --error \
        "$title wasn't installed. The window that just closed showed the reason.<br>Try the Store (Bazaar) for this app instead."
    fi
    ;;
  *.deb)
    kdialog --title "$name" --yes-label "Open the Store" --no-label "Close" --warningyesno \
"<b>$name</b> is an installer for Ubuntu and Debian, not for SparkOS, so it can't be installed by double-clicking.<br><br>
Most apps are in the Store (Bazaar), where they install with one click and update by themselves.
Search for the app's name there.<br><br>If the app is only offered as a .deb, check its website for a
Flatpak, AppImage or .rpm download instead." && open_store
    ;;
  *)
    kdialog --sorry "SparkOS doesn't know how to open $name."
    ;;
esac
