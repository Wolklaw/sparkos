#!/bin/bash
# Session for the experimental Spark compositor (spark-wl). Never the default; picked on the
# login screen. Runs spark-compositor, which runs spark-wl-startup once it is up.
# sparkwl first (the portals pick their backends from it), Spark too so OnlyShowIn=Spark
# autostarts (Spark Tray) run
export XDG_CURRENT_DESKTOP=sparkwl:Spark
export XDG_SESSION_DESKTOP=spark-wl
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland,x11
# SSH keys: openssh's ssh-agent.socket (a user unit, on by default) listens here
[ -n "$XDG_RUNTIME_DIR" ] && export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$XDG_RUNTIME_DIR/ssh-agent.socket}"
# The login screen starts this script directly, so no shell profile runs: put the user's own
# command folders on PATH the way Fedora's bashrc does. Spark Store installs apps into
# ~/.local/bin, and Settings and the shell find them (spark-connect) by name.
for d in "$HOME/bin" "$HOME/.local/bin"; do
  case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
done
export PATH

# Developer builds: when ~/.local/share/spark-dev/bin exists, a spark-compositor,
# spark-wl-startup or spark-shell in it is used instead of the image's, so a fix can be tried
# with a logout instead of a new image. Delete the folder to go back to the image's versions.
comp=/usr/bin/spark-compositor
startup=/usr/libexec/spark-wl-startup
dev="$HOME/.local/share/spark-dev/bin"
if [ -d "$dev" ]; then
  export PATH="$dev:$PATH"
  [ -x "$dev/spark-compositor" ] && comp="$dev/spark-compositor"
  [ -x "$dev/spark-wl-startup" ] && startup="$dev/spark-wl-startup"
fi
# Every session's output is kept in ~/.local/state/spark-wl/logs (the last 10): the login
# screen truncates its own log at the next login, which is when a crash gets looked at.
logs="${XDG_STATE_HOME:-$HOME/.local/state}/spark-wl/logs"
if mkdir -p "$logs" 2>/dev/null; then
  ls -1t "$logs"/session-*.log 2>/dev/null | tail -n +10 | xargs -r rm -f
  log="$logs/session-$(date +%Y%m%d-%H%M%S).log"
  if [ -t 1 ]; then
    # greetd hands us the VT itself: anything printed there shows as text on a black screen
    # between the sign-in screen and the desktop, so the log goes to the file only
    exec >>"$log" 2>&1 </dev/null
  else
    exec > >(tee -a "$log") 2>&1 || true
  fi
elif [ -t 1 ]; then
  exec >/dev/null 2>&1 </dev/null
fi
echo "spark-wl session start $(date -Is)"
exec "$comp" -s "$startup"
