#!/usr/bin/bash
# Sets up SparkOS's developer tools for the current user. Safe to run again: it only adds what's missing.
#
#   sparkos-dev-setup            Claude Code, then Node, Python, GitHub CLI and JDK 17 (Homebrew)
#   sparkos-dev-setup --claude   Claude Code only
#   sparkos-dev-setup --brew     Homebrew tools only
set -euo pipefail

BREWFILE=/usr/share/sparkos/Brewfile
want_claude=1 want_brew=1
case "${1:-}" in
  --claude) want_brew=0 ;;
  --brew) want_claude=0 ;;
  "") ;;
  -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "Unknown option: $1 (see --help)" >&2; exit 1 ;;
esac

export PATH="$HOME/.local/bin:$PATH"

if [ "$want_claude" = 1 ]; then
  if command -v claude >/dev/null 2>&1; then
    echo "Claude Code is already installed: $(claude --version 2>/dev/null || echo unknown version). It updates itself."
  else
    echo "Installing Claude Code with Anthropic's official installer (into ~/.local, no admin rights)..."
    curl -fsSL https://claude.ai/install.sh | bash
    command -v claude >/dev/null 2>&1 || { echo "Claude Code didn't install. See the messages above." >&2; exit 1; }
    echo "Claude Code installed: $(claude --version 2>/dev/null)"
    echo "Start it from the app menu (Claude Code), by right-clicking a folder in Dolphin, or with: sparkos-claude"
  fi
fi

if [ "$want_brew" = 1 ]; then
  if ! command -v brew >/dev/null 2>&1 && [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  fi
  if ! command -v brew >/dev/null 2>&1; then
    if [ -f /usr/share/homebrew.tar.zst ]; then   # Bazzite base: unpacked by brew-setup.service
      echo "Homebrew isn't ready yet. Log out and back in once, then run: sparkos-dev-setup --brew" >&2
    else                                          # Fedora base: no Homebrew in the image
      echo "Homebrew isn't installed. Install it with Homebrew's installer (https://brew.sh), open a new terminal, then run: sparkos-dev-setup --brew" >&2
    fi
    exit 1
  fi
  echo "Installing from $BREWFILE:"
  grep -E '^brew ' "$BREWFILE" | sed 's/^/  /'
  brew bundle --file="$BREWFILE"
  # Homebrew's daily update timers are off until now (00-sparkos-homebrew.preset): turn them on.
  # (Bazzite base only; the Fedora base has no such timers: update with brew upgrade.)
  for timer in brew-update.timer brew-upgrade.timer; do
    [ -f "/usr/lib/systemd/system/$timer" ] || continue
    if ! systemctl is-enabled --quiet "$timer" 2>/dev/null; then
      echo "Turning on Homebrew's daily updates (asks for your password)..."
      pkexec systemctl enable --now brew-update.timer brew-upgrade.timer \
        || echo "Not turned on. Homebrew still works; update it yourself with: brew upgrade"
      break
    fi
  done
fi

echo "Done. Open a new terminal to use the tools."
