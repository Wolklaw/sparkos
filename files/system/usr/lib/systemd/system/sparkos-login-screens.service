[Unit]
Description=Give the sign-in screen the desktop's monitor layout
# After /var/home is there, before the sign-in screen starts its KWin
After=local-fs.target
Before=display-manager.service plasmalogin.service
ConditionPathExists=/usr/libexec/sparkos-login-screens

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/sparkos-login-screens
# A problem here must never hold up the sign-in screen
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
