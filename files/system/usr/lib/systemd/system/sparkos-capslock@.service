[Unit]
Description=Caps Lock turns on and off when pressed (%I)
Documentation=file:///usr/lib/udev/rules.d/80-sparkos-capslock.rules
# Started by udev for each physical keyboard; stops when the keyboard is unplugged
BindsTo=dev-input-%i.device
After=dev-input-%i.device
ConditionPathExists=/usr/libexec/sparkos-capslock

[Service]
ExecStart=/usr/libexec/sparkos-capslock /dev/input/%I
# If it stops, the keyboard works the Linux way until it's back
Restart=on-failure
RestartSec=1
# It needs the keyboard and /dev/uinput, nothing else
DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
