#!/usr/bin/python3
"""Pick the screen a screen-sharing request gets (xdg-desktop-portal-wlr chooser).

xdg-desktop-portal-wlr runs this with chooser_type=simple and reads one line
"Monitor: NAME" from stdout. Exit non-zero to cancel the share.

Spark Snip names the screen it wants in $XDG_RUNTIME_DIR/spark-snip/screen
just before it asks the portal; that answer is used once and removed. Any other
app gets a small window listing the screens.
"""
import json
import os
import subprocess
import sys
import time

HINT = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}',
                    'spark-snip', 'screen')
HINT_MAX_AGE = 30


def outputs():
    try:
        text = subprocess.run(['wlr-randr', '--json'], capture_output=True,
                              text=True, timeout=5).stdout
        return [o for o in json.loads(text) if o.get('enabled')]
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def from_hint(names):
    try:
        age = time.time() - os.stat(HINT).st_mtime
        with open(HINT, encoding='utf-8') as fh:
            name = fh.read().strip()
        os.unlink(HINT)
    except OSError:
        return None
    if age > HINT_MAX_AGE or (names and name not in names):
        return None
    return name or None


def ask(outs):
    import tkinter as tk

    bg, panel, line, text, muted, accent, on_accent = (
        '#04090b', '#0a1517', '#1f6a66', '#d4f1ec', '#6f9f98', '#3de8c8', '#02130f')
    font = 'monospace'
    root = tk.Tk()
    root.title('Share a screen')
    root.configure(bg=bg, padx=16, pady=14)
    root.resizable(False, False)
    chosen = {'name': None}

    tk.Label(root, text='SHARE A SCREEN', bg=bg, fg=accent,
             font=(font, 9, 'bold')).pack(anchor='w')
    tk.Label(root, text='An app wants to record or share one screen.', bg=bg,
             fg=muted, font=(font, 9)).pack(anchor='w', pady=(2, 10))

    def pick(name):
        chosen['name'] = name
        root.destroy()

    for o in outs:
        mode = next((m for m in o.get('modes', []) if m.get('current')), {})
        size = f"{mode.get('width', '?')}x{mode.get('height', '?')}"
        label = f"{o['name']}   {size}   {o.get('make', '')} {o.get('model', '')}".strip()
        b = tk.Button(root, text=label, anchor='w', bg=panel, fg=text, bd=0,
                      relief='flat', highlightthickness=1, highlightbackground=line,
                      activebackground=accent, activeforeground=on_accent,
                      font=(font, 10), padx=12, pady=8, cursor='hand2',
                      command=lambda n=o['name']: pick(n))
        b.pack(fill='x', pady=3)
    tk.Button(root, text='CANCEL', bg=bg, fg=muted, bd=0, relief='flat',
              activebackground=bg, activeforeground=text, font=(font, 9, 'bold'),
              command=root.destroy).pack(anchor='e', pady=(10, 0))
    root.bind('<Escape>', lambda _e: root.destroy())
    root.attributes('-topmost', True)
    root.mainloop()
    return chosen['name']


def main():
    outs = outputs()
    names = [o['name'] for o in outs]
    name = from_hint(names)
    if not name:
        if len(names) == 1:
            name = names[0]
        elif names:
            try:
                name = ask(outs)
            except Exception:                       # noqa: BLE001 - no Tk or no display
                name = names[0]
    if not name:
        return 1
    print(f'Monitor: {name}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
