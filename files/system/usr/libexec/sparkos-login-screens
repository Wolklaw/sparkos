#!/usr/bin/bash
# Give the sign-in screen the same monitor layout as the desktop: which screen is the main one,
# where each sits, rotation, resolution and refresh rate.
#
# The sign-in screen (Plasma Login Manager) runs its own KWin as the "plasmalogin" user and reads
# that user's own ~/.config/kwinoutputconfig.json. With none, KWin falls back to defaults: no
# rotation, and the main screen picked by connector order, which can change from boot to boot.
# Login Screen settings can copy the file over ("Apply Plasma Settings"), but only when someone
# clicks it, and again after every layout change. This runs at each boot, before the sign-in
# screen, and copies the layout of the user who changed their screens most recently.
set -euo pipefail

greeter_home=$(getent passwd plasmalogin | cut -d: -f6)
[ -n "$greeter_home" ] && [ -d "$greeter_home" ] || { echo "no plasmalogin user, nothing to do"; exit 0; }

# Everything under a user's home is theirs to change while this runs as root, so each file is read once, with
# O_NOFOLLOW at every step below the home (no symlinked ~/.config or file), checked on the open file (a plain file the
# user owns, small, valid JSON) and saved as a root-owned copy. Only that copy is ever installed.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fetch() {  # fetch <uid> <home> <out>: prints the file's mtime; fails when the file isn't usable
  python3 -I - "$@" <<'PY'
import json, os, stat, sys
uid, home, out = int(sys.argv[1]), sys.argv[2], sys.argv[3]
nofollow = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
try:
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)   # from the account database
    st = os.fstat(fd)
    if st.st_uid != uid:
        sys.exit(1)
    fd = os.open(".config", nofollow | os.O_DIRECTORY, dir_fd=fd)
    f = os.open("kwinoutputconfig.json", nofollow | os.O_NONBLOCK, dir_fd=fd)
    st = os.fstat(f)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or not 0 < st.st_size < 1048576:
        sys.exit(1)
    data = os.read(f, st.st_size + 1)
    if len(data) != st.st_size:
        sys.exit(1)
    json.loads(data)
    with os.fdopen(os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), "wb") as o:
        o.write(data)
except (OSError, ValueError):
    sys.exit(1)
print(int(st.st_mtime))
PY
}

newest=""
newest_time=0
n=0
while IFS=: read -r _ _ uid _ _ home _; do
  [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
  n=$((n + 1))
  copy="$work/layout.$n"
  t=$(fetch "$uid" "$home" "$copy" 2>/dev/null) || continue
  if [ "$t" -gt "$newest_time" ]; then newest="$copy"; newest_time="$t"; fi
done < <(getent passwd)

[ -n "$newest" ] || { echo "no user has a usable saved screen layout yet"; exit 0; }

dest="$greeter_home/.config/kwinoutputconfig.json"
if [ -f "$dest" ] && cmp -s "$newest" "$dest"; then
  echo "sign-in screen already has the layout of the newest user"
  exit 0
fi
install -d -o plasmalogin -g plasmalogin -m 0755 "$greeter_home/.config"
install -o plasmalogin -g plasmalogin -m 0644 "$newest" "$dest"
restorecon -F "$greeter_home/.config" "$dest" 2>/dev/null || true
echo "sign-in screen now uses the screen layout of the newest user"
