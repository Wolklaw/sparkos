#!/bin/sh
# Started by spark-compositor once WAYLAND_DISPLAY and DISPLAY exist. Runs the Spark shell the
# same way the KWin Spark session does (spark-session-run: environment for D-Bus activation and
# systemd, the session target, the shell restarted if it crashes), with spark-wl-workspace.target,
# which starts graphical-session.target (portals need it), the polkit agent and autostart apps,
# but no KDE helpers. Without the Spark shell in the image, it opens a terminal.
if [ -x /usr/libexec/spark-session-run ] && command -v spark-shell >/dev/null 2>&1; then
  SPARK_SESSION_TARGET=spark-wl-workspace.target exec /usr/libexec/spark-session-run
fi
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE XDG_SESSION_DESKTOP 2>/dev/null
for t in spark-terminal foot xterm; do
  command -v "$t" >/dev/null 2>&1 && exec "$t"
done
