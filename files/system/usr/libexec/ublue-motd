#!/bin/sh
# SparkOS's terminal banner, in place of Bazzite's "Welcome to Bazzite" (which drew a Markdown
# table with glow in every new shell). /etc/profile.d/user-motd.sh runs this in each interactive
# shell unless ~/.config/no-show-user-motd exists; `ujust toggle-user-motd` turns it on and off.
# One line, no programs started, so a new tab opens as fast without it.
#
#   ▍▍ SPARKOS  system commands: ujust · hide this line: ujust toggle-user-motd

[ -t 1 ] || exit 0
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
  fr*) more="commandes système : ujust · masquer cette ligne : ujust toggle-user-motd" ;;
  *)   more="system commands: ujust · hide this line: ujust toggle-user-motd" ;;
esac
if [ "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ]; then
  printf 'SPARKOS  %s\n' "$more"
else
  # the magenta and cyan channels, then the name in mint and the rest muted (SparkOS colours)
  printf '\033[38;2;255;46;136m▍\033[38;2;34;216;255m▍\033[0m \033[1;38;2;155;232;184mSPARKOS\033[0m  \033[38;2;179;176;210m%s\033[0m\n' "$more"
fi
