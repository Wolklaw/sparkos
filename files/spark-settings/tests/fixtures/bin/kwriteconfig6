#!/usr/bin/env python3
"""Fake kwriteconfig6: logs the call and keeps the value in a plain ini file under
$XDG_CONFIG_HOME, so what one page writes the next read sees. Never touches a real setting."""
import configparser
import os
import sys

with open(os.environ.get('FAKE_LOG', os.devnull), 'a') as f:
    f.write('kwriteconfig6 ' + ' '.join(sys.argv[1:]) + '\n')
a = sys.argv[1:]
file, groups, key, delete, value = None, [], None, False, None
i = 0
while i < len(a):
    if a[i] == '--file':
        file = a[i + 1]
        i += 2
    elif a[i] == '--group':
        groups.append(a[i + 1])
        i += 2
    elif a[i] == '--key':
        key = a[i + 1]
        i += 2
    elif a[i] == '--delete':
        delete = True
        i += 1
    elif a[i] == '--type':
        i += 2
    else:
        value = a[i]
        i += 1
base = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
path = file if os.path.isabs(file) else os.path.join(base, file)
cp = configparser.RawConfigParser(strict=False, interpolation=None)
cp.optionxform = str
cp.read(path)
sec = ']['.join(groups) or 'General'
if not cp.has_section(sec):
    cp.add_section(sec)
if delete:
    cp.remove_option(sec, key)
else:
    cp.set(sec, key, value or '')
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, 'w') as fh:
    cp.write(fh, space_around_delimiters=False)
