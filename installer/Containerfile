# The SparkOS installer (live ISO) image. Build with:
#   podman build --cap-add sys_admin --security-opt label=disable -t localhost/payload:latest installer/
# Adapted from Bazzite's installer (github.com/ublue-os/bazzite, Apache-2.0).

ARG BASE_IMAGE=${BASE_IMAGE:-ghcr.io/wolklaw/sparkos:latest}
ARG INSTALL_IMAGE_PAYLOAD=${INSTALL_IMAGE_PAYLOAD:-ghcr.io/wolklaw/sparkos:latest}

FROM $BASE_IMAGE
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
# Optional: the digest INSTALL_IMAGE_PAYLOAD must be (installer-iso.yml pins it)
ARG INSTALL_IMAGE_DIGEST=""
RUN --mount=type=bind,source=./.,target=/src \
    env \
    BASE_IMAGE="$BASE_IMAGE" \
    INSTALL_IMAGE_PAYLOAD="$INSTALL_IMAGE_PAYLOAD" \
    INSTALL_IMAGE_DIGEST="$INSTALL_IMAGE_DIGEST" \
    /src/build.sh
